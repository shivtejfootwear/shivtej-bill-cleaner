<?xml version="1.0" encoding="utf-8"?>
<!-- Google backup and phone-to-phone transfer (Android 12+): codes, learning, settings and bill records. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
